<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<title>Quản lý phòng</title>

<link rel="stylesheet" href="/css/admin.css">
</head>
<body>

<div class="container">

    <div class="topbar">

        <h1>
            ❤️ Quản lý phòng
        </h1>

        <div>

            <a
                href="/admin"
                class="home-btn"
            >
                Dashboard
            </a>

            <a
                href="/admin/rooms/add"
                class="add-btn"
            >
                ➕ Tạo phòng
            </a>

        </div>

    </div>

    <div class="table-card">

        <table>

            <thead>

                <tr>

                    <th>ID</th>
                    <th>Mã phòng</th>
                    <th>Tên phòng</th>
                    <th>Thành viên</th>
                    <th>Thao tác</th>

                </tr>

            </thead>

            <tbody>

                <% rooms.forEach(room=>{ %>

                <tr>

                    <td>
                        <%= room.id %>
                    </td>

                    <td>
                        <%= room.room_code %>
                    </td>

                    <td>
                        <%= room.room_name %>
                    </td>

                    <td>
                        <%= room.total_users %>
                    </td>

                    <td>

                        <a
                        href="/admin/rooms/delete/<%= room.id %>"
                        class="delete-btn"
                        >
                            Xóa
                        </a>

                    </td>

                </tr>

                <% }) %>

            </tbody>

        </table>

    </div>

</div>

</body>
</html>