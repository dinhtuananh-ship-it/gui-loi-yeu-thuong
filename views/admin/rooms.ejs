<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<title>Quản lý phòng</title>

<link rel="stylesheet" href="/css/admin.css">
</head>
<body>

<div class="container">

    <div class="topbar">

        <h1>🏠 Quản lý phòng</h1>

        <div>

            <a href="/admin" class="home-btn">
                Dashboard
            </a>

        </div>

    </div>

    <div class="form-card">

        <h2>Tạo mã phòng mới</h2>

        <form action="/admin/rooms/add" method="POST">

            <input
                type="text"
                name="room_code"
                placeholder="Ví dụ: LOVE001"
                required
            >

            <button type="submit">
                Tạo phòng
            </button>

        </form>

    </div>

    <div class="table-card">

        <table>

            <thead>

                <tr>

                    <th>ID</th>
                    <th>Mã phòng</th>
                    <th>Số thành viên</th>
                    <th>Thao tác</th>

                </tr>

            </thead>

            <tbody>

                <% rooms.forEach(room => { %>

                <tr>

                    <td>
                        <%= room.id %>
                    </td>

                    <td>
                        <%= room.room_code %>
                    </td>

                    <td>
                        <%= room.member_count %>
                    </td>

                    <td>

                        <a
                            href="/admin/rooms/delete/<%= room.id %>"
                            class="delete-btn"
                            onclick="return confirm('Xóa phòng này?')"
                        >
                            Xóa
                        </a>

                    </td>

                </tr>

                <% }) %>

            </tbody>

        </table>

    </div>

</div>

</body>
</html>