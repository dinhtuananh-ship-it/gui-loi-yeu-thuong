<%- include('../partials/head', { title: 'Quản lý phòng' }) %>
<div class="admin-wrap"><header class="admin-header"><a class="brand" href="/admin"><span class="brand-mark">♡</span><span>gửi lời<br><strong>yêu thương.</strong></span></a><nav><a href="/admin">Câu hỏi</a><form action="/logout" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="text-link">Đăng xuất ↗</button></form></nav></header><div class="eyebrow">✳ &nbsp; KHÔNG GIAN QUẢN TRỊ</div><h1>Những căn phòng <em>nhỏ.</em></h1><p class="lead">Mỗi mã phòng là một không gian riêng cho tối đa hai người.</p><% if (error) { %><div class="alert" role="alert"><%= error %></div><% } %><div class="editor-card compact"><form action="/admin/rooms/add" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label for="room_code">TẠO MÃ PHÒNG MỚI</label><div class="inline-form"><input id="room_code" name="room_code" pattern="[A-Za-z0-9-]{3,32}" maxlength="32" placeholder="Ví dụ: LOVE001" required><button class="button" type="submit">Tạo phòng ↗</button></div></form></div><div class="section-heading"><span><%= rooms.length %> PHÒNG ĐÃ TẠO</span></div><div class="admin-list"><% rooms.forEach(room => { %><article class="admin-row"><span class="story-index">#<%= room.id %></span><strong><%= room.room_code %></strong><span class="muted"><%= room.member_count %> / 2 thành viên</span><div class="row-actions"><form action="/admin/rooms/delete/<%= room.id %>" method="post" onsubmit="return confirm('Xóa phòng và toàn bộ thành viên, câu trả lời, kỷ niệm trong phòng?')"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit">Xóa phòng</button></form></div></article><% }) %></div></div></body></html>
