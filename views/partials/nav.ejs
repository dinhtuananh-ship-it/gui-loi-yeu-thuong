<main class="main">
  <header class="topbar"><span class="topbar-note">MỘT KHÔNG GIAN CHỈ DÀNH CHO HAI BẠN</span><div class="top-actions"><span class="user-pill"><span class="avatar"><%= user.username.slice(0, 1).toUpperCase() %></span><%= user.username %></span><form action="/logout" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="logout" type="submit" title="Đăng xuất">Đăng xuất ↗</button></form></div></header>
