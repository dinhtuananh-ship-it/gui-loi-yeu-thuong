    <a href="/history" class="<%= active === 'history' ? 'selected' : '' %>"><span>▤</span> Nhật ký</a>
    <a href="/memories" class="<%= active === 'memories' ? 'selected' : '' %>"><span>♡</span> Kỷ niệm</a>
