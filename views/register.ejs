<form action="/register" method="POST">

    <input
        type="text"
        name="username"
        placeholder="Tên đăng nhập"
        required
    >

    <input
        type="password"
        name="password"
        placeholder="Mật khẩu"
        required
    >

    <input
        type="text"
        name="room_code"
        placeholder="Mã phòng (VD: LOVE001)"
        required
    >

    <button type="submit">
        Đăng ký
    </button>

</form>