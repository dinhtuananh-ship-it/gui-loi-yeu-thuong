<%- include('partials/head', { title: 'Nhật ký' }) %>
<div class="layout"><%- include('partials/nav', { active: 'history' }) %>
<section class="page-content"><div class="eyebrow">✳ &nbsp; NHỮNG LỜI ĐÃ NÓI</div><h1>Nhật ký <em>hai ta.</em></h1><p class="lead">Nơi những lời chân thành được lưu lại, để một ngày nào đó cùng nhau đọc lại.</p>
<div class="section-heading"><span><%= grouped.length %> CHƯƠNG NHỎ ĐÃ VIẾT</span><span>♡</span></div>
<% if (!grouped.length) { %><div class="empty-state"><span>✉</span><h2>Trang đầu vẫn đang chờ hai bạn.</h2><p>Khi cả hai trả lời cùng một câu hỏi, những lời nhắn sẽ hiện ở đây.</p><a class="button" href="/">Trở về hôm nay ↗</a></div><% } %>
<div class="story-list"><% grouped.forEach((item, index) => { %><article class="story-card"><span class="story-index">CHƯƠNG <%= String(index + 1).padStart(2, '0') %></span><h2><%= item.question %></h2><div class="answer-grid"><% item.answers.forEach(ans => { %><div class="answer-tile"><div class="answer-author"><span class="member-avatar"><%= ans.username.slice(0, 1).toUpperCase() %></span><strong><%= ans.username %></strong></div><p><%= ans.answer %></p></div><% }) %></div></article><% }) %></div>
</section></main></div></body></html>
