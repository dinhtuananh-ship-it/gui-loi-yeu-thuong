<%- include('partials/head', { title: 'Kỷ niệm' }) %>
<div class="layout"><%- include('partials/nav', { active: 'memories' }) %>
<section class="page-content"><div class="eyebrow">✳ &nbsp; NHỮNG KHOẢNH KHẮC ĐÁNG NHỚ</div><h1>Hộp <em>kỷ niệm.</em></h1><p class="lead">Giữ lại những ngày thật đẹp, để khi nhớ nhau ta luôn có nơi để quay về.</p>
<div class="section-heading"><span><%= memories.length %> KHOẢNH KHẮC ĐÃ LƯU</span><a class="button" href="/memories/add">+ Thêm kỷ niệm</a></div>
<% if (!memories.length) { %><div class="empty-state"><span>♡</span><h2>Kỷ niệm đầu tiên đang đợi bạn.</h2><p>Viết về một cuộc hẹn, một ngày đặc biệt, hoặc chỉ một điều nhỏ khiến bạn mỉm cười.</p><a class="button" href="/memories/add">Viết kỷ niệm đầu tiên ↗</a></div><% } %>
<div class="memory-grid"><% memories.forEach(memory => { %><article class="memory-card"><span class="memory-decoration">✳</span><span class="story-index"><%= new Date(memory.created_at).toLocaleDateString('vi-VN', {day:'2-digit', month:'long', year:'numeric'}) %></span><h2><%= memory.title %></h2><p class="preview"><%= memory.content %></p><div class="memory-bottom"><span>Viết bởi <strong><%= memory.username %></strong></span><button class="open-memory" type="button" data-memory-id="memory-<%= memory.id %>">Đọc tiếp ↗</button></div><template id="memory-<%= memory.id %>"><h2><%= memory.title %></h2><span class="story-index"><%= memory.username %> · <%= new Date(memory.created_at).toLocaleDateString('vi-VN') %></span><p class="memory-full"><%= memory.content %></p></template></article><% }) %></div>
</section></main></div>
<dialog id="memory-dialog" class="memory-dialog"><button type="button" class="dialog-close" aria-label="Đóng">×</button><div id="dialog-body"></div></dialog>
<script src="/js/memories.js" defer></script></body></html>
