<%- include('partials/head', { title: 'Đăng nhập' }) %>
<div class="auth-layout">
  <div class="auth-art"><a class="brand" href="/"><span class="brand-mark">♡</span><span>gửi lời<br><strong>yêu thương.</strong></span></a><div class="art-center"><span class="art-icon">✳</span><div class="art-heart">♡</div><p>"Tình yêu bắt đầu từ<br>những điều mình sẻ chia."</p></div><span class="art-footer">MỘT GÓC NHỎ CHỈ DÀNH CHO HAI TA ✦</span></div>
  <div class="auth-side"><div class="auth-inner">
    <div class="eyebrow">✳ &nbsp; THẬT VUI VÌ BẠN ĐÃ QUAY LẠI</div>
    <h1>Chào mừng <em>trở lại.</em></h1>
    <p class="lead">Những câu chuyện của hai bạn đang đợi ở đây.</p>
    <% if (error) { %><div class="alert" role="alert"><%= error %></div><% } %>
    <form action="/login" method="post" class="auth-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label for="username">TÊN ĐĂNG NHẬP</label>
      <input id="username" name="username" autocomplete="username" maxlength="50" required autofocus placeholder="Tên của bạn">
      <label for="password">MẬT KHẨU</label>
      <input id="password" name="password" type="password" autocomplete="current-password" required placeholder="Nhập mật khẩu">
      <button class="button" type="submit">Vào không gian của mình ↗</button>
    </form>
    <p class="auth-hint">Dùng một trình duyệt khác hoặc cửa sổ ẩn danh để đăng nhập tài khoản của người ấy cùng lúc.</p>
    <p class="auth-switch">Chưa có tài khoản? <a href="/register">Tạo tài khoản ngay →</a></p>
  </div></div>
</div></body></html>
