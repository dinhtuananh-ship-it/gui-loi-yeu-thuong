<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<title>Đăng nhập</title>
<link rel="stylesheet" href="/css/auth.css">
</head>

<body>

<div class="auth-container">

    <div class="auth-card">

        <h1>💕 Gửi lời yêu thương</h1>

        <p>Đăng nhập để tiếp tục</p>

        <form action="/login" method="POST">

            <input
                type="text"
                name="username"
                placeholder="Tên đăng nhập"
                required
            >

            <input
                type="password"
                name="password"
                placeholder="Mật khẩu"
                required
            >

            <button type="submit">
                Đăng nhập
            </button>

        </form>

        <a href="/register">
            Chưa có tài khoản?
        </a>

    </div>

</div>

</body>
</html>