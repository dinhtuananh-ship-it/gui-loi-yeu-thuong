<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<title>Gửi lời yêu thương</title>

<link rel="stylesheet" href="/css/style.css">

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">

</head>
<body>

<div class="container">

    <div class="sidebar">

        <div class="logo">
            ❤️ Gửi lời yêu thương
        </div>

        <ul>

            <li class="active">
                <i class="fa-solid fa-house"></i>
                Trang chủ
            </li>
    <li>
    <a href="/history" class="menu-link">
        <i class="fa-solid fa-book-open"></i>
        Nhật ký
    </a>
</li>

<li>
    <a href="/memories" class="menu-link">
        <i class="fa-solid fa-heart"></i>
        Kỷ niệm
    </a>
</li>

        </ul>

    </div>

    <div class="main">

        <div class="topbar">

            <div class="user-box">

                <% if(user){ %>

                    Xin chào,
                    <strong>
                        <%= user.username %>
                    </strong>

                <% } %>

            </div>

            <a href="/logout" class="logout">
                Đăng xuất
            </a>

        </div>

        <div class="hero">

            <h1>
                💕 Gửi lời yêu thương 💕
            </h1>

            <p>
                Nơi lưu giữ những cảm xúc đẹp nhất
            </p>

        </div>

        <div class="question-card">

            <% if(question){ %>

                <span class="badge">
                    CÂU HỎI HIỆN TẠI
                </span>

                <h2>
                    <%= question.question %>
                </h2>

                <% if(waiting){ %>

                    <div class="status-box waiting">

                        <h3>
                            ✅ Bạn đã trả lời
                        </h3>

                        <p>
                            ⏳ Đang chờ người ấy trả lời...
                        </p>

                        <small>
                            Khi cả hai hoàn thành,
                            câu hỏi tiếp theo sẽ tự động mở.
                        </small>

                    </div>

                <% } else { %>

                    <form
                        action="/answer"
                        method="POST"
                    >

                        <input
                            type="hidden"
                            name="question_id"
                            value="<%= question.id %>"
                        >

                        <textarea
                            name="answer"
                            placeholder="Nhập câu trả lời của bạn..."
                            required
                        ></textarea>

                        <button type="submit">
                            💌 Gửi câu trả lời
                        </button>

                    </form>

                <% } %>

            <% } else { %>

                <div class="status-box complete">

                    <h2>
                        🎉 Hai bạn đã hoàn thành tất cả câu hỏi
                    </h2>

                    <p>
                        Cảm ơn vì đã cùng nhau lưu giữ những kỷ niệm đẹp ❤️
                    </p>

                </div>

            <% } %>

        </div>

    </div>

</div>

</body>
</html>